@page "/command-stream"
@rendermode InteractiveServer
@using Smart_X_Ecosystem.Models
@using Smart_X_Ecosystem.Services
@using System.Net.Http.Json
@using System.Globalization
@inject CommandStreamService StreamService
@inject FirebaseAuthService AuthService
@inject NavigationManager NavManager
@inject HttpClient Http
@implements IDisposable

<PageTitle>Live Telemetry &amp; Command Stream</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="container mt-5">
        <div class="alert alert-warning shadow-sm">
            <h5>🔒 Authentication Required</h5>
            <p class="mb-2">Please sign in on the Console page to access Live Telemetry &amp; Controls.</p>
            <button class="btn btn-primary btn-sm" @onclick='() => NavManager.NavigateTo("/")'>Go to Sign In</button>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-2">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h2 class="fw-bold text-primary mb-0">Live Telemetry &amp; Command Stream</h2>
                <p class="text-muted mb-0">Real-Time Event Pipeline, Automated Priority Dispatch, Sensor Trend Analytics &amp; Predictive Diagnostics</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-dark">Processed Packets: @StreamService.TotalPacketsProcessedByWorker</span>
                <span class="badge bg-success">Operator: @AuthService.CurrentUserEmail</span>
            </div>
        </div>

        <div class="alert alert-secondary py-2 px-3 small d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="spinner-grow spinner-grow-sm text-success me-2" role="status"></span>
                <strong>Background Ingestion Worker:</strong> <code>@StreamService.LastBackgroundProcessedSummary</code>
            </div>
            <span class="badge bg-primary">Priority Alerts Drained First (1.5s cycle)</span>
        </div>

        @if (!string.IsNullOrEmpty(StatusBanner))
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm py-2" role="alert">
                <strong>System Notification:</strong> @StatusBanner
                <button type="button" class="btn-close" @onclick="() => StatusBanner = string.Empty"></button>
            </div>
        }

        <!-- 1. PREDICTIVE ACTION ENGINE -->
        <div class="card border-warning shadow-sm mb-4">
            <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark">⚡ Predictive Diagnostics &amp; Recommended Actions</h5>
                <small class="text-muted">Logged Operator Events: @StreamService.RecordedUserHistory.Count</small>
            </div>
            <div class="card-body">
                @{
                    var recommendations = StreamService.GetPredictiveRecommendations();
                }
                @if (recommendations.Count == 0)
                {
                    <p class="text-muted mb-0">All subsystems operating within nominal thresholds. No immediate operator intervention required.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var rec in recommendations)
                        {
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h6 class="fw-bold text-danger mb-1">@rec.Title</h6>
                                            <span class="badge bg-dark">
                                                @rec.ConfidencePercentage.ToString("0.0")% Confidence (@rec.MatchedCount/@rec.TotalObservations)
                                            </span>
                                        </div>
                                        <p class="small text-muted mb-2">@rec.Reason</p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <code class="small">Node: @rec.TargetMac</code>
                                        <button class="btn btn-sm btn-warning fw-bold" @onclick="() => ExecuteRecommendedAction(rec)">
                                            Execute: @rec.SuggestedCommand
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 2. PACKET QUEUES & COMMAND ROLLBACK HISTORY -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                        <span>Ingestion Pipeline &amp; Fault Simulation Controls</span>
                        <span class="badge bg-light text-primary">Automated Worker Active</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button class="btn btn-outline-primary btn-sm" @onclick="SimulateStandardPacket">
                                + Standard Reading
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="SimulateMoistureDrop">
                                ⚠️ Low Moisture Alert (&lt; 20%)
                            </button>
                            <button class="btn btn-warning btn-sm text-dark" @onclick="SimulatePowerSpike">
                                ⚡ 450V Grid Surge Alert
                            </button>
                            <button class="btn btn-secondary btn-sm" @onclick="SimulateDisconnect">
                                🔌 Node Dropoff Event
                            </button>
                            <button class="btn btn-dark btn-sm" @onclick="SimulateBurstPriorityBypass">
                                🚀 High-Load Priority Preemption Test
                            </button>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="p-2 border rounded bg-danger bg-opacity-10 d-flex justify-content-between fw-bold text-danger">
                                    <span>Critical Alert Queue (Priority 1)</span>
                                    <span>@StreamService.CriticalAlertQueue.Count queued</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 border rounded bg-primary bg-opacity-10 d-flex justify-content-between fw-bold text-primary">
                                    <span>Standard Telemetry Stream</span>
                                    <span>@StreamService.TelemetryQueue.Count queued</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Operator Command Rollback Stack</span>
                        <button class="btn btn-sm btn-outline-warning" @onclick="UndoLastOverride">
                            ↩ Revert Last Command (@StreamService.CommandUndoStack.Count)
                        </button>
                    </div>
                    <div class="card-body p-2" style="max-height: 170px; overflow-y: auto;">
                        @if (StreamService.CommandUndoStack.Count == 0)
                        {
                            <p class="text-muted small text-center my-4">No manual overrides issued in this session.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @foreach (var cmd in StreamService.CommandUndoStack)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@cmd.DeviceName</strong>: @cmd.ActionDescription
                                            <div class="text-muted" style="font-size: 0.75rem;">@cmd.TargetMac | @cmd.IssuedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                                        </div>
                                        <span class="badge bg-secondary">Revertible</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. LIVE TELEMETRY TREND CHART -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">
                    📈 Real-Time Sensor Telemetry Trend
                </span>
                <span class="badge bg-primary">High-Resolution Sequenced Stream</span>
            </div>
            <div class="card-body">
                @{
                    var chartPoints = StreamService.SensorTimeline.Values.TakeLast(16).ToList();
                }
                <svg width="100%" height="150" viewBox="0 0 800 150" style="background: #0f172a; border-radius: 0.5rem;">
                    @if (chartPoints.Count > 1)
                    {
                        double stepX = 720.0 / Math.Max(1, chartPoints.Count - 1);
                        var polyPoints = new List<string>();
                        for (int i = 0; i < chartPoints.Count; i++)
                        {
                            double x = 40 + (i * stepX);
                            double clampedVal = Math.Clamp(chartPoints[i].Value, 0, 500);
                            double y = 125 - (clampedVal / 500.0 * 100.0);
                            polyPoints.Add($"{x.ToString("0.0", CultureInfo.InvariantCulture)},{y.ToString("0.0", CultureInfo.InvariantCulture)}");
                        }
                        <polyline fill="none" stroke="#38bdf8" stroke-width="3" points="@string.Join(" ", polyPoints)" />

                        @for (int i = 0; i < chartPoints.Count; i++)
                        {
                            double x = 40 + (i * stepX);
                            double clampedVal = Math.Clamp(chartPoints[i].Value, 0, 500);
                            double y = 125 - (clampedVal / 500.0 * 100.0);
                            <circle cx="@x.ToString("0.0", CultureInfo.InvariantCulture)" cy="@y.ToString("0.0", CultureInfo.InvariantCulture)" r="4" fill="#f59e0b" />
                            @(new MarkupString($"<text x=\"{x.ToString("0.0", CultureInfo.InvariantCulture)}\" y=\"{Math.Max(15, y - 8).ToString("0.0", CultureInfo.InvariantCulture)}\" fill=\"#e2e8f0\" font-size=\"9\" text-anchor=\"middle\">{chartPoints[i].Value}{chartPoints[i].Unit}</text>"))
                        }
                    }
                </svg>
            </div>
        </div>

        <!-- 4. DEVICE REGISTRY & ACTIVE FAULT MONITORS -->
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-4 fw-bold">
                                Connected Fleet Directory
                            </div>
                            <div class="col-md-4">
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" placeholder="Filter by device or MAC..." @bind="SearchQuery" @bind:event="oninput" />
                                    <button class="btn btn-primary" @onclick="LogSearchPattern">Search</button>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select form-select-sm" @bind="SelectedCategory">
                                    <option value="All">All Subsystems</option>
                                    @foreach (var cat in StreamService.ActiveCategoriesSet)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select form-select-sm" @bind="SelectedAlertFilter">
                                    <option value="All">All States</option>
                                    <option value="Online">Nominal</option>
                                    <option value="Faulty">Active Faults</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>MAC Address</th>
                                    <th>Endpoint</th>
                                    <th>Live Telemetry</th>
                                    <th>Status</th>
                                    <th>Relay</th>
                                    <th>Remote Control</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in FilteredDevices)
                                {
                                    double pct = Math.Clamp((device.LastReading / device.MaxGaugeValue) * 100.0, 5.0, 100.0);
                                    <tr>
                                        <td><code>@device.MacAddress</code></td>
                                        <td>
                                            <div class="fw-bold">@device.DeviceName</div>
                                            <span class="badge bg-info text-dark">@device.Category</span>
                                        </td>
                                        <td style="min-width: 190px;">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span class="fw-bold">@device.LastReading @device.Unit</span>
                                                <span class="text-muted">/ @device.MaxGaugeValue @device.Unit</span>
                                            </div>
                                            <div class="progress" style="height: 10px;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated @(device.Status == "Alert" ? "bg-danger" : device.Status == "Offline" ? "bg-secondary" : "bg-success")"
                                                     role="progressbar" style="width: @(pct.ToString("0"))%"></div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(device.Status == "Online" ? "bg-success" : device.Status == "Alert" ? "bg-danger" : "bg-secondary")">
                                                @device.Status
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(device.IsRelayActive ? "bg-primary" : "bg-dark")">
                                                @(device.IsRelayActive ? "ON" : "OFF")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-dark" @onclick="() => TriggerOverride(device)">
                                                Toggle Relay
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- ACTIVE ERROR STATES -->
                <div class="card shadow-sm mb-3 border-warning">
                    <div class="card-header bg-warning text-dark fw-bold">
                        Active Fault Alarms
                    </div>
                    <div class="card-body p-2">
                        @if (StreamService.ActiveErrorStates.Count == 0)
                        {
                            <p class="text-success small mb-0">No active fault alarms.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @foreach (var err in StreamService.ActiveErrorStates)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center text-dark fw-semibold">
                                        <code>@err</code>
                                        <span class="badge bg-warning text-dark">Active Fault</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <!-- DISCONNECTED NODES -->
                <div class="card shadow-sm mb-3 border-danger">
                    <div class="card-header bg-danger text-white fw-bold">
                        Unreachable Endpoints
                    </div>
                    <div class="card-body p-2">
                        @if (StreamService.DisconnectedNodes.Count == 0)
                        {
                            <p class="text-success small mb-0">All registered endpoints reachable.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @foreach (var mac in StreamService.DisconnectedNodes)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center text-danger fw-bold">
                                        <span>@mac</span>
                                        <span class="badge bg-danger">Offline</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <!-- CHRONOLOGICAL EVENT STREAM -->
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white fw-bold">
                        Chronological Telemetry Feed
                    </div>
                    <div class="card-body p-2" style="max-height: 220px; overflow-y: auto;">
                        <ul class="list-group list-group-flush small">
                            @foreach (var entry in StreamService.SensorTimeline.Reverse())
                            {
                                <li class="list-group-item px-1 py-1">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-primary fw-bold font-monospace">[@entry.Key.ToString()]</span>
                                        <span class="badge bg-light text-dark">@entry.Value.Value @entry.Value.Unit</span>
                                    </div>
                                    <div>@entry.Value.Summary</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string SearchQuery { get; set; } = string.Empty;
    private string SelectedCategory { get; set; } = "All";
    private string SelectedAlertFilter { get; set; } = "All";
    private string StatusBanner { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        StreamService.OnStreamUpdated += HandleStreamUpdated;
    }

    private void HandleStreamUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StreamService.OnStreamUpdated -= HandleStreamUpdated;
    }

    private IEnumerable<DeviceState> FilteredDevices => StreamService.DeviceRegistry.Values
        .Where(d => string.IsNullOrWhiteSpace(SearchQuery) ||
                    d.DeviceName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    d.MacAddress.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(d => SelectedCategory == "All" || d.Category.Equals(SelectedCategory, StringComparison.OrdinalIgnoreCase))
        .Where(d => SelectedAlertFilter == "All" ||
                    (SelectedAlertFilter == "Online" && d.Status == "Online") ||
                    (SelectedAlertFilter == "Faulty" && (StreamService.DisconnectedNodes.Contains(d.MacAddress) || d.Status != "Online")));

    private void LogSearchPattern()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            StreamService.RecordUserSearch(SearchQuery);
            StatusBanner = $"Filter logged for '{SearchQuery}'. Operator telemetry preferences updated.";
        }
    }

    private async Task SimulateStandardPacket()
    {
        var req = new TelemetrySimulationRequest
        {
            MacAddress = "00:1B:44:11:3A:D9",
            Reading = Math.Round(21.0 + Random.Shared.NextDouble() * 6.0, 1),
            IsCriticalAlert = false
        };
        await Http.PostAsJsonAsync("/api/stream/simulate", req);
        StatusBanner = "Standard telemetry packet dispatched to the ingestion stream.";
    }

    private async Task SimulateMoistureDrop()
    {
        var req = new TelemetrySimulationRequest
        {
            MacAddress = "00:1B:44:11:3A:B7",
            Reading = 14.5,
            IsCriticalAlert = true
        };
        await Http.PostAsJsonAsync("/api/stream/simulate", req);
        StatusBanner = "Critical low-moisture alert dispatched to high-priority queue.";
    }

    private async Task SimulatePowerSpike()
    {
        var req = new TelemetrySimulationRequest
        {
            MacAddress = "00:1B:44:11:3A:C2",
            Reading = 450.0,
            IsCriticalAlert = true
        };
        await Http.PostAsJsonAsync("/api/stream/simulate", req);
        StatusBanner = "450V overvoltage alert dispatched to high-priority queue.";
    }

    private async Task SimulateDisconnect()
    {
        var req = new TelemetrySimulationRequest
        {
            MacAddress = "00:1B:44:11:3A:C1",
            Reading = 0,
            SimulateDisconnect = true
        };
        var res = await Http.PostAsJsonAsync("/api/stream/simulate", req);
        var payload = await res.Content.ReadFromJsonAsync<ApiMessage>();
        StatusBanner = payload?.Message ?? "Node disconnect event processed.";
    }

    private async Task SimulateBurstPriorityBypass()
    {
        for (int i = 0; i < 3; i++)
        {
            await Http.PostAsJsonAsync("/api/stream/simulate", new TelemetrySimulationRequest
            {
                MacAddress = "00:1B:44:11:3A:D9",
                Reading = Math.Round(22.0 + i, 1),
                IsCriticalAlert = false
            });
        }
        await Http.PostAsJsonAsync("/api/stream/simulate", new TelemetrySimulationRequest
        {
            MacAddress = "00:1B:44:11:3A:B7",
            Reading = 12.8,
            IsCriticalAlert = true
        });
        StatusBanner = "Dispatched 3 standard readings + 1 critical alert simultaneously. Priority worker will preempt normal queue.";
    }

    private async Task TriggerOverride(DeviceState device)
    {
        var cmd = new OverrideCommand
        {
            TargetMac = device.MacAddress,
            DeviceName = device.DeviceName,
            ActionDescription = $"Toggled Relay to {(!device.IsRelayActive ? "ON" : "OFF")}"
        };
        await Http.PostAsJsonAsync("/api/stream/override", cmd);
        StatusBanner = $"Remote override executed on {device.DeviceName}.";
    }

    private async Task UndoLastOverride()
    {
        var res = await Http.PostAsync("/api/stream/undo", null);
        var payload = await res.Content.ReadFromJsonAsync<ApiMessage>();
        StatusBanner = payload?.Message ?? "Command rollback completed.";
    }

    private async Task ExecuteRecommendedAction(PredictiveRecommendation rec)
    {
        var cmd = new OverrideCommand
        {
            TargetMac = rec.TargetMac,
            DeviceName = rec.Title,
            ActionDescription = rec.SuggestedCommand
        };
        await Http.PostAsJsonAsync("/api/stream/override", cmd);
        StatusBanner = $"Executed automated action: '{rec.SuggestedCommand}' on {rec.TargetMac}.";
    }

    private class ApiMessage
    {
        public string Message { get; set; } = string.Empty;
    }
}

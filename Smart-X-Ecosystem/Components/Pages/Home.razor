@page "/"
@rendermode InteractiveServer
@using Smart_X_Ecosystem.Services
@inject NavigationManager NavManager
@inject FirebaseAuthService AuthService
@inject CommandStreamService StreamService
<PageTitle>Smart-X Enterprise IoT Platform</PageTitle>

<div class="container-fluid py-2">
    @if (!AuthService.IsAuthenticated)
    {
        <!-- HERO HEADER -->
        <div class="p-4 p-md-5 mb-4 text-white rounded-4 shadow-sm" style="background: linear-gradient(135deg, #0b192c 0%, #1e3e62 60%, #000000 100%);">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-info bg-opacity-10 border border-info border-opacity-25 mb-3">
                        <span class="spinner-grow spinner-grow-sm text-info" role="status"></span>
                        <small class="fw-semibold text-info">SMART-X INDUSTRIAL TELEMETRY & MESH ROUTING ENGINE v3.0</small>
                    </div>
                    <h1 class="display-5 fw-bold mb-3">Next-Gen Edge Microcontroller & Self-Healing Mesh Orchestration</h1>
                    <p class="lead text-light opacity-75 mb-4">
                        Unified real-time ingestion, AES-256 encrypted batch provisioning, O(1) device state indexing, Prim's Minimum Spanning Tree routing, and AVL Tree historical analytics.
                    </p>
                </div>
            </div>
        </div>

        <!-- LOGIN PORTAL -->
        <div class="row justify-content-center my-4">
            <div class="col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-gradient bg-primary text-white p-4 text-center">
                        <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-semibold shadow-sm mb-2">SECURE GATEWAY</span>
                        <h4 class="fw-bold mb-1">Operator Portal</h4>
                        <p class="text-white-50 small mb-0">Sign in via Firebase to unlock all 3 IoT modules</p>
                    </div>

                    <div class="card-body p-4 bg-white">
                        @if (!string.IsNullOrEmpty(AuthMessage))
                        {
                            <div class="alert @(AuthSuccess ? "alert-success" : "alert-danger") small py-2 mb-3">
                                @AuthMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold small">Operator Email</label>
                            <input type="email" class="form-control" placeholder="operator@smartx.io" @bind="Email" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold small">Password</label>
                            <input type="password" class="form-control" placeholder="••••••••" @bind="Password" />
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-primary py-2 fw-semibold" @onclick="HandleSignIn" disabled="@IsBusy">
                                @(IsBusy ? "Authenticating..." : "Sign In to Dashboard")
                            </button>
                            <button class="btn btn-outline-secondary py-2 small" @onclick="HandleSignUp" disabled="@IsBusy">
                                Create New Operator Account
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- STATEFUL SINGLE-PAGE PILLAR WORKSPACE BAR (ZERO STATE LOSS ON SWITCH) -->
        <div class="card shadow-sm border-0 mb-4 bg-dark text-white">
            <div class="card-body py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn @(ActivePillar == 1 ? "btn-primary fw-bold" : "btn-outline-light")" @onclick="() => ActivePillar = 1">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Pillar 1: Sensor Data Ingestion
                    </button>
                    <button class="btn @(ActivePillar == 2 ? "btn-success fw-bold" : "btn-outline-light")" @onclick="() => ActivePillar = 2">
                        <i class="bi bi-activity me-1"></i> Pillar 2: Real-Time Command Stream
                    </button>
                    <button class="btn @(ActivePillar == 3 ? "btn-info text-dark fw-bold" : "btn-outline-light")" @onclick="() => ActivePillar = 3">
                        <i class="bi bi-diagram-3 me-1"></i> Pillar 3: Network Topology & Mesh Routing
                    </button>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <small class="text-white-50">Authenticated: <code class="text-info">@AuthService.CurrentUserEmail</code></small>
                    <button class="btn btn-sm btn-outline-danger" @onclick="AuthService.SignOut">Sign Out</button>
                </div>
            </div>
        </div>

        <!-- RENDER ACTIVE PILLAR INLINE WITHOUT ROUTE RELOAD -->
        @if (ActivePillar == 1)
        {
            <Ingestion />
        }
        else if (ActivePillar == 2)
        {
            <CommandStream />
        }
        else if (ActivePillar == 3)
        {
            <NetworkTopology />
        }
    }
</div>

@code {
    private int ActivePillar { get; set; } = 3; // Default to Module 3 (Final PoE) or switch seamlessly
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string AuthMessage { get; set; } = string.Empty;
    private bool AuthSuccess { get; set; }
    private bool IsBusy { get; set; }

    private async Task HandleSignIn()
    {
        IsBusy = true;
        var result = await AuthService.SignInAsync(Email, Password);
        AuthSuccess = result.Success;
        AuthMessage = result.Message;
        IsBusy = false;
    }

    private async Task HandleSignUp()
    {
        IsBusy = true;
        var result = await AuthService.SignUpAsync(Email, Password);
        AuthSuccess = result.Success;
        AuthMessage = result.Message;
        IsBusy = false;
    }
}
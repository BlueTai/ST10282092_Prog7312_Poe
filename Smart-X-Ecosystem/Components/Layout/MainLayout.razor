@inherits LayoutComponentBase
@using Smart_X_Ecosystem.Services
@inject FirebaseAuthService AuthService
@inject CommandStreamService StreamService
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-bar">
            <div class="d-flex w-100 justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-cpu text-primary fs-5"></i>
                    <span class="fw-semibold text-dark">Smart-X Industrial IoT Cloud</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 ms-2 rounded-pill">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>System Online
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (AuthService.IsAuthenticated)
                    {
                        <span class="small text-muted d-none d-md-inline">
                            Active Nodes: <strong class="text-dark">@StreamService.DeviceRegistry.Count</strong>
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            <i class="bi bi-person-check-fill text-primary me-1"></i>@AuthService.CurrentUserEmail
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">
                            Unauthenticated Session
                        </span>
                    }
                </div>
            </div>
        </header>

        <article class="content-area">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += HandleStateChanged;
        StreamService.OnStreamUpdated += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleStateChanged;
        StreamService.OnStreamUpdated -= HandleStateChanged;
    }
}